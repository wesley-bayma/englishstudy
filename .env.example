# English Study Hub - Exemplo de Variáveis de Ambiente
# Crie sua chave em: https://aistudio.google.com/apikey

GEMINI_API_KEY=sua_chave_gemini_aqui
# Opcional. O padrão estável atual é gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
# Contingência automática se o Gemini falhar. Use uma chave privada no servidor.
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_FALLBACK_MODEL=z-ai/glm-5.3-flash
# Use valores fortes e diferentes para a senha e o segredo de sessão.
APP_PASSWORD=defina_uma_senha_forte
SESSION_SECRET=gere_uma_string_aleatoria_com_ao_menos_32_caracteres
GEMINI_TIMEOUT_MS=50000
# Somente para testes locais controlados; não configure endpoints mock em produção.
# GEMINI_API_BASE_URL=http://127.0.0.1:4010/models
# OPENROUTER_API_BASE_URL=http://127.0.0.1:4010/chat/completions
